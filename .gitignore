# === 絶対にコミットしてはいけないもの ===

# 録音データと文字起こし結果（自分の声・相手の声・会議内容が入る）
recordings/

# 保存先は config.json で変更できるため、既定の recordings/ の外に出ることが
# ある。フォルダ名だけに頼らず、中身の種類でも弾いておく（多層防御）。
*.wav
*.mp3
*.m4a
*.flac
*.ogg
*.aac
*.wma
*.mp4
*.mkv
*.webm
*.mov
meta.json
segments.json
transcript.txt
*_segments.json
*_transcript.txt

# 利用者ごとの設定。保存先の絶対パス（ユーザー名を含む）が入る。
# 無ければ config.py の既定値から自動生成されるので、配布に不要
config.json

# 音声認識モデル（約4.5GB。初回に自動取得される）
models/

# === 環境・生成物 ===

# 仮想環境（絶対パスとユーザー名が埋まっている。移植も不可）
.venv/
venv/

# PyInstaller の生成物
build/
dist/
*.manifest

# Python
__pycache__/
*.py[cod]
*.egg-info/

# ログ
gui_error.log
*.log

# OS / エディタ
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
